# Copie para `.env.local` (ignorado pelo Git) e preencha só o que precisar.
# Sem nenhuma variável o app roda em modo demo (dados em memória + auth local).
# Variáveis EXPO_PUBLIC_* vão para o bundle e ficam públicas: nunca coloque segredos aqui.
# Depois de alterar, reinicie com `npm start -- --clear` (e refaça o build nativo se mexeu
# nas chaves do Google Maps).

# --- API REST (Node/Express). Com ela definida, o app passa a usar os repositórios HTTP ---
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=8000

# --- Firebase Auth (só é usado junto com EXPO_PUBLIC_API_URL) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps nativo (lidas pelo app.config.ts, não vão para o bundle JS) ---
# Expo Go ignora estas chaves e usa a do próprio Expo: elas valem em development build
# (`npm run android:native` / `npm run ios:native`) e em build de loja (EAS).
# Pode ser a mesma chave nas duas, mas o recomendado é uma por plataforma, cada uma restrita.
#
# Android: habilite "Maps SDK for Android"; restrinja a apps Android com o pacote
# br.edu.unifacig.ecoponto + SHA-1 do certificado. Sem esta chave o mapa fica em branco
# na development build.
GOOGLE_MAPS_ANDROID_API_KEY=
# iOS: habilite "Maps SDK for iOS"; restrinja a apps iOS com o bundle id
# br.edu.unifacig.ecoponto. Vazia → o app usa o Apple Maps (sem chave e sem custo).
GOOGLE_MAPS_IOS_API_KEY=

# Places e Geocoding NÃO têm chave aqui: o app chama o ecoponto-api, que guarda a
# chave do Google no servidor (GET /places/autocomplete e GET /places/:placeId).

# Copie para `.env` e preencha. O `.env` não vai para o git.
# Variáveis EXPO_PUBLIC_* entram no bundle JS: nunca coloque segredo nelas.

# --- API (vazio = modo demo, com dados em memória) ---
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=8000

# --- Firebase Auth (só é usado junto com EXPO_PUBLIC_API_URL) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps nativo (lidas pelo app.config.ts, não pelo JS) ---
# Expo Go ignora: use em development build ou build de loja.
# Android: chave restrita a "Maps SDK for Android" + pacote br.edu.unifacig.ecoponto + SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
# iOS: deixe vazio para usar o Apple Maps (sem chave e sem custo).
GOOGLE_MAPS_IOS_API_KEY=

# Places e Geocoding NÃO têm chave aqui: o app chama o ecoponto-api, que guarda a
# chave do Google no servidor (GET /places/autocomplete e GET /places/:placeId).
